generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  CUSTOMER
  BRAND
}

enum BrandStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  type      UserType @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  brand     Brand?

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]

  @@map("categories")
}

model Brand {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  status      BrandStatus @default(PENDING)
  userId      Int         @unique @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  products    Product[]

  @@map("brands")
}

model Certificate {
  id            Int                  @id @default(autoincrement())
  name          String               @unique
  description   String?
  issuingBody   String               @map("issuing_body")
  products      ProductCertificate[]

  @@map("certificates")
}

model Product {
  id           Int                  @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal              @db.Decimal(10, 2)
  photoUrl     String?              @map("photo_url")
  categoryId   Int                  @map("category_id")
  brandId      Int                  @map("brand_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  category     Category             @relation(fields: [categoryId], references: [id])
  brand        Brand                @relation(fields: [brandId], references: [id])
  certificates ProductCertificate[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductCertificate {
  productId     Int         @map("product_id")
  certificateId Int         @map("certificate_id")
  product       Product     @relation(fields: [productId], references: [id])
  certificate   Certificate @relation(fields: [certificateId], references: [id])

  @@id([productId, certificateId])
  @@index([certificateId])
  @@map("product_certificates")
}
