# .env.example
#
# Copy to .env and fill in. NO secret has a default value: the variables
# marked REQUIRED need a value from you, otherwise `docker compose up` fails
# naming the missing one (and, in production, the application refuses to start without JWT_SECRET).
#
# To generate a random value:
#   Linux/macOS:  openssl rand -hex 24
#   Windows:      node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# ============================================
# DATABASE
# ============================================
# REQUIRED (Docker Compose). Use only letters and numbers: it goes inside a URL.
POSTGRES_PASSWORD=

# REQUIRED (Docker Compose). Same.
REDIS_PASSWORD=

# Only to run the application OUTSIDE Docker (`npm run dev`, tests). The
# development Docker Compose publishes Postgres and Redis on 127.0.0.1.
# Replace <POSTGRES_PASSWORD> and <REDIS_PASSWORD> with the values above.
DATABASE_URL=postgresql://ecoshop:<POSTGRES_PASSWORD>@localhost:5432/ecoshop
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# ============================================
# JWT AUTHENTICATION
# ============================================
# REQUIRED. At least 32 random characters. Example values (such as
# "changeme") are refused in production.
JWT_SECRET=

# ============================================
# ARTIFICIAL INTELLIGENCE
# ============================================
# Google Gemini API key (get one at https://aistudio.google.com/)
GEMINI_KEY=

# Azure Custom Vision (image classification)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Minimum confidence for identification (0.0 to 1.0, default: 0.7)
AI_CONFIDENCE_THRESHOLD=0.7

# ============================================
# PUBLIC APPLICATION URL
# ============================================
# Used to generate links in emails, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# ADMINISTRATOR (prisma/seed-admin.ts)
# ============================================
# REQUIRED: at least 12 characters. No default value.
# Note: in development the seed resets this user's password on every start.
ADMIN_PASSWORD=

# Administrator email (default: admin@ecoshop.com)
ADMIN_EMAIL=admin@ecoshop.com

# Administrator name (default: EcoShop Administrator)
ADMIN_NAME=EcoShop Administrator

# Administrator phone (optional)
ADMIN_PHONE=

# ============================================
# DEMO DATA (development only; prisma/seed.ts)
# ============================================
# REQUIRED for the demo seed (development compose): at least
# 12 characters. All demo users share this same password.
# NOT used in production: there the catalog starts empty and only the ADMIN is created.
SEED_USER_PASSWORD=

# ============================================
# REVERSE PROXY (per-IP rate limit)
# ============================================
# How many trusted proxies sit in front of the application. The client IP is the
# Nth entry, counted from the end, of x-forwarded-for. Default 1 (one reverse proxy,
# as in the publishing compose); 0 ignores the header.
TRUST_PROXY_HOPS=1
