index 0000000..d61ecd8
--- /dev/null
+++ b/tests/integration/helpers.ts
@@ -0,0 +1,41 @@
+// tests/integration/helpers.ts
+// Utilitários dos testes de integração: ambiente, requisições e cookies de sessão.
+// Requer DATABASE_URL (Postgres) e, opcionalmente, REDIS_URL. Veja README.
+
+process.env.JWT_SECRET ??= "test-secret-at-least-32-characters-long";
+
+import { NextRequest } from "next/server";
+import { signToken } from "@/lib/auth";
+import { prisma } from "@/lib/db";
+
+export type Tipo = "CLIENTE" | "MARCA" | "ADMIN";
+
+export async function criarUsuarioDireto(email: string, tipo: Tipo = "CLIENTE") {
+  await prisma.usuario.deleteMany({ where: { email } });
+  return prisma.usuario.create({
+    data: { nome: "Teste " + tipo, email, senha: "hash-qualquer", tipo },
+  });
+}
+
+export async function cookieDe(u: { id: number; email: string; tipo: Tipo }) {
+  const token = await signToken({ id: u.id, email: u.email, tipo: u.tipo });
+  return `token=${token}`;
+}
+
+export function req(
+  url: string,
+  opts: { method?: string; cookie?: string; body?: unknown } = {},
+) {
+  return new NextRequest(`http://localhost${url}`, {
+    method: opts.method ?? "GET",
+    headers: {
+      "content-type": "application/json",
+      ...(opts.cookie ? { cookie: opts.cookie } : {}),
+    },
+    body: opts.body === undefined ? undefined : JSON.stringify(opts.body),
+  });
+}
+
+export const ctx = (id: number | string) => ({
+  params: Promise.resolve({ id: String(id) }),
+});
diff --git a/tests/integration/usuarios-sem-senha.test.ts b/tests/integration/usuarios-sem-senha.test.ts
new file mode 100644
index 0000000..6f75300
--- /dev/null
+++ b/tests/integration/usuarios-sem-senha.test.ts
@@ -0,0 +1,50 @@
+// D2 — Respostas de usuário nunca expõem o hash da senha (Constitution, Art. IV).
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { prisma } from "@/lib/db";
+import { redis } from "@/lib/redis";
+import { criarUsuarioDireto, cookieDe, req, ctx } from "./helpers";
+import { POST as criarUsuarioRoute } from "@/app/api/usuarios/route";
+import { PUT as atualizarUsuarioRoute } from "@/app/api/usuarios/[id]/route";
+
+after(async () => {
+  await prisma.$disconnect();
+  await redis.quit().catch(() => {});
+});
+
+test("D2: POST /api/usuarios (admin) não devolve senha", async () => {
+  const admin = await criarUsuarioDireto("d2-admin@test.local", "ADMIN");
+  const cookie = await cookieDe(admin);
+  await prisma.usuario.deleteMany({ where: { email: "d2-novo@test.local" } });
+
+  const res = await criarUsuarioRoute(
+    req("/api/usuarios", {
+      method: "POST",
+      cookie,
+      body: { nome: "Novo Usuario", email: "d2-novo@test.local", senha: "12345678" },
+    }),
+  );
+  assert.equal(res.status, 201);
+  const corpo = await res.json();
+  assert.ok(corpo.usuario.id);
+  assert.equal("senha" in corpo.usuario, false, "resposta não pode conter senha");
+});
+
+test("D2: PUT /api/usuarios/[id] não devolve senha", async () => {
+  const admin = await criarUsuarioDireto("d2-admin2@test.local", "ADMIN");
+  const alvo = await criarUsuarioDireto("d2-alvo@test.local", "CLIENTE");
+  const cookie = await cookieDe(admin);
+
+  const res = await atualizarUsuarioRoute(
+    req(`/api/usuarios/${alvo.id}`, {
+      method: "PUT",
+      cookie,
+      body: { nome: "Nome Atualizado" },
+    }),
+    ctx(alvo.id),
+  );
+  assert.equal(res.status, 200);
+  const corpo = await res.json();
+  assert.equal(corpo.usuario.nome, "Nome Atualizado");
+  assert.equal("senha" in corpo.usuario, false, "resposta não pode conter senha");
+});
