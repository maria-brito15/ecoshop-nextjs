diff --git a/tests/integration/chat-ia-acesso.test.ts b/tests/integration/chat-ia-acesso.test.ts
new file mode 100644
index 0000000..38573b6
--- /dev/null
+++ b/tests/integration/chat-ia-acesso.test.ts
@@ -0,0 +1,42 @@
+// D3 — O chat de IA exige autenticação e tem limite de uso (Constitution, Art. III.3).
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { prisma } from "@/lib/db";
+import { redis, redisDelPattern } from "@/lib/redis";
+import { criarUsuarioDireto, cookieDe, req } from "./helpers";
+import { POST as chat } from "@/app/api/ia/chat/route";
+
+after(async () => {
+  await prisma.$disconnect();
+  await redis.quit().catch(() => {});
+});
+
+const corpo = { mensagem: "Como descartar pilhas?" };
+
+test("D3: sem login, o chat responde 401 e não chama a IA", async () => {
+  const res = await chat(req("/api/ia/chat", { method: "POST", body: corpo }));
+  assert.equal(res.status, 401);
+});
+
+test("D3: autenticado, mas sem GEMINI_KEY, responde 503", async () => {
+  delete process.env.GEMINI_KEY;
+  const u = await criarUsuarioDireto("d3-user@test.local");
+  const res = await chat(
+    req("/api/ia/chat", { method: "POST", cookie: await cookieDe(u), body: corpo }),
+  );
+  assert.equal(res.status, 503);
+});
+
+test("D3: excesso de mensagens por usuário responde 429", async () => {
+  delete process.env.GEMINI_KEY;
+  await redisDelPattern("rate_limit:*");
+  const u = await criarUsuarioDireto("d3-rate@test.local");
+  const cookie = await cookieDe(u);
+  let ultimo = 0;
+  for (let i = 0; i < 25; i++) {
+    const res = await chat(req("/api/ia/chat", { method: "POST", cookie, body: corpo }));
+    ultimo = res.status;
+    if (ultimo === 429) break;
+  }
+  assert.equal(ultimo, 429);
+});
diff --git a/tests/integration/helpers.ts b/tests/integration/helpers.ts
