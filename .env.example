# .env.example
#
# Copie para .env e preencha. NENHUM segredo tem valor padrão: as variáveis
# marcadas OBRIGATÓRIA precisam de um valor seu, senão `docker compose up` falha
# nomeando a que faltou (e, em produção, a aplicação recusa iniciar sem JWT_SECRET).
#
# Para gerar um valor aleatório:
#   Linux/macOS:  openssl rand -hex 24
#   Windows:      node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# ============================================
# BANCO DE DADOS
# ============================================
# OBRIGATÓRIA (Docker Compose). Use só letras e números: vai dentro de uma URL.
POSTGRES_PASSWORD=

# OBRIGATÓRIA (Docker Compose). Idem.
REDIS_PASSWORD=

# Só para rodar a aplicação FORA do Docker (`npm run dev`, testes). O Docker
# Compose de desenvolvimento publica o Postgres e o Redis em 127.0.0.1.
# Troque <POSTGRES_PASSWORD> e <REDIS_PASSWORD> pelos valores acima.
DATABASE_URL=postgresql://ecoshop:<POSTGRES_PASSWORD>@localhost:5432/ecoshop
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# ============================================
# AUTENTICAÇÃO JWT
# ============================================
# OBRIGATÓRIA. Mínimo 32 caracteres aleatórios. Valores-exemplo (como
# "changeme") são recusados em produção.
JWT_SECRET=

# ============================================
# INTELIGÊNCIA ARTIFICIAL
# ============================================
# Google Gemini API key (obter em https://aistudio.google.com/)
GEMINI_KEY=

# Azure Custom Vision (classificação de imagens)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Confiança mínima para identificação (0.0 a 1.0, padrão: 0.7)
AI_CONFIDENCE_THRESHOLD=0.7

# ============================================
# URL PÚBLICA DA APLICAÇÃO
# ============================================
# Usado para gerar links em emails, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# ADMINISTRADOR (prisma/seed-admin.ts)
# ============================================
# OBRIGATÓRIA: mínimo 12 caracteres. Sem valor padrão.
# Atenção: em desenvolvimento o seed redefine a senha deste usuário a cada subida.
ADMIN_PASSWORD=

# Email do administrador (padrão: admin@ecoshop.com)
ADMIN_EMAIL=admin@ecoshop.com

# Nome do administrador (padrão: Administrador EcoShop)
ADMIN_NAME=Administrador EcoShop

# Telefone do administrador (opcional)
ADMIN_PHONE=

# ============================================
# DADOS DE DEMONSTRAÇÃO (somente desenvolvimento; prisma/seed.ts)
# ============================================
# OBRIGATÓRIA para o seed de demonstração (compose de desenvolvimento): mínimo
# 12 caracteres. Todos os usuários de demonstração usam esta mesma senha.
# NÃO é usada em produção: lá o catálogo começa vazio e só o ADMIN é criado.
SEED_USER_PASSWORD=

# ============================================
# PROXY REVERSO (rate limit por IP)
# ============================================
# Quantos proxies confiáveis existem à frente da aplicação. O IP do cliente é a
# N-ésima entrada, contada do fim, de x-forwarded-for. Padrão 1 (um proxy reverso,
# como no compose de publicação); 0 ignora o cabeçalho.
TRUST_PROXY_HOPS=1
